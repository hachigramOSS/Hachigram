    <string name="CP_Message_Filtering">message filtering</string>
    <string name="CP_Message_Filtering_Filter">enable filter</string>
    <string name="CP_Message_Filtering_Filter_Desc">when the filter is enabled, selected words in incoming messages will automatically be hidden under a spoiler effect, making them unreadable until revealed.</string>
    <string name="CP_Message_Filtering_Field">enter words to filter</string>
    <string name="CP_Message_Filtering_Field_Desc">separate words with a comma, space, or line break. use parentheses to group multiple words into a phrase. case insensitive.
        \nexample: word, another, (multiple words here).
    </string>
    <string name="CP_Message_Filtering_Translit">translit detection</string>
    <string name="CP_Message_Filtering_Translit_Desc">when enabled, the filter will also detect words written in transliteration (for example, \"test\" will be recognized as \"тест\").
        this helps to catch and hide messages under a spoiler even if cyrillic letters are replaced with latin ones. may slightly increase device CPU load.
    </string>
    <string name="CP_Message_Filtering_Exact_Words">exact word match</string>
    <string name="CP_Message_Filtering_Exact_Words_Desc">when enabled, only words that fully match those in the filter list will be hidden.
        if a word appears in a different form (with prefixes, endings, or inside other words), it will not be hidden.
    </string>
    <string name="CP_Message_Filtering_Exclusions">exclusions</string>
    <string name="CP_Message_Filtering_Exclude_Destination">to update exclusions</string>
    <string name="CP_Message_Filtering_Exclude_Sure">will be excluded</string>
    <string name="CP_Message_Filtering_Entities">link entity filter</string>
    <string name="CP_Message_Filtering_EntitiesDesc">when enabled, this option extends filtering to links (entities) contained in messages. the system will scan the URLs for any of your configured filter keywords.
        if a match is found inside the link, the entire message will be automatically hidden under a spoiler, regardless of whether the keyword appears in the visible text or not.
        \n\nthis helps protect against disguised spam, hidden advertising, or phishing domains that could otherwise bypass regular text-based filtering.
    </string>
    <string name="CP_Message_Filtering_FilterBlocked">filter messages from blocked users</string>
    <string name="CP_Message_Filtering_HideBlocked">hide messages from blocked users</string>
    <string name="CP_Message_Filtering_HideBlockedDesc">when enabled, all messages and forwarded messages from blocked users will automatically be hidden under a spoiler.</string>
    <string name="CP_Message_Filtering_HideAll">entire message spoiler</string>
    <string name="CP_Message_Filtering_HideAllDesc">hides the entire message text and media under a spoiler if it contains a filtered word.</string>
    <string name="CP_Message_Filtering_Collapse">collapse messages</string>
    <string name="CP_Message_Filtering_Collapse_Desc">when enabled, messages will automatically be collapsed. You can expand them by tapping on the message.</string>
    <string name="CP_Message_Filtering_Transparent">message transparency</string>
    <string name="CP_Message_Filtering_Transparent_Desc">filtered messages become transparent so you can easily tell them apart.</string>

